# Copy to .env on the acahti host (never commit). scripts/install.sh fills secrets.

DOMAIN=acahti.example.com
ROOT_URL=https://acahti.example.com
ACAHTI_ORG=acme

# Acahti admin (created by configure.sh). Email is {user}@noreply.{DOMAIN}.
ACAHTI_ADMIN_USER=acahti
# ACAHTI_ADMIN_PASSWORD=

# Optional: SSH spec for the Runner. One ROLE=both Runner. Do not install on the acahti host.
# ACAHTI_BUILD=user@build-host

# Woodpecker <-> Forgejo OAuth on the compose net (filled by configure.sh).
# Redirect is http://localhost:8000/ci/authorize only.
WOODPECKER_FORGEJO_CLIENT=
WOODPECKER_FORGEJO_SECRET=
WOODPECKER_AGENT_SECRET=
WOODPECKER_TOKEN=

# Postgres (forgejo + woodpecker databases)
POSTGRES_PASSWORD=

# Gateway. LAN / laptop preview hits this bind. Public URL still goes through your edge.
ACAHTI_SESSION_SECRET=
ACAHTI_ADMIN_TOKEN=
# Shared token so Acahti can expand pipe: before the Runner runs.
ACAHTI_CONFIG_TOKEN=
GATEWAY_BIND=0.0.0.0:8080

# Public Argos dash origin. Gateway joins /runs/{sid} from e2e logs
# (Woodpecker redacts ARGOS_DASH_URL in the printed dash line).
# ARGOS_DASH_URL=https://argos.example.com

# Bind data root on the acahti host
ACAHTI_DATA=/var/lib/acahti

# Runner gRPC on the acahti host (LAN / ssh-reverse; do not publish to the internet)
WOODPECKER_GRPC_ADDR=:9000
