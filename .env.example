# Copy to .env on the acahti host (never commit). scripts/install.sh fills secrets.

DOMAIN=acahti.example.com
ROOT_URL=https://acahti.example.com
ACAHTI_ORG=acme

# Forgejo admin (created by configure.sh). Email is {user}@noreply.{DOMAIN}.
ACAHTI_ADMIN_USER=acahti
# ACAHTI_ADMIN_PASSWORD=

# Optional: SSH spec for buildof. One ROLE=both agent. Do not install on the acahti host.
# ACAHTI_BUILD=user@buildof

# Woodpecker <-> Forgejo OAuth (filled by configure.sh)
WOODPECKER_FORGEJO_CLIENT=
WOODPECKER_FORGEJO_SECRET=
WOODPECKER_AGENT_SECRET=
WOODPECKER_TOKEN=

# Postgres (forgejo + woodpecker databases)
POSTGRES_PASSWORD=

# Gateway. Office / laptop preview hits this bind. Public URL still goes through your edge.
ACAHTI_SESSION_SECRET=
ACAHTI_ADMIN_TOKEN=
GATEWAY_BIND=0.0.0.0:8080

# Bind data root on the acahti host
ACAHTI_DATA=/var/lib/acahti

# Git SSH on the acahti host (not via HTTP)
GIT_SSH_PORT=2222

# Agent gRPC on the acahti host (LAN / ssh-reverse; do not publish to the internet)
WOODPECKER_GRPC_ADDR=:9000
